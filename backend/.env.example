# backend/.env.example
# 실제 값은 backend/.env 에 채워 넣는다 (git에 커밋하지 않음, .gitignore 등록됨)

# PostgreSQL 연결 (docker-compose.yml 기본값과 일치)
DATABASE_URL=postgresql+psycopg://final_app:final_app_pw@localhost:5544/final_project

# JWT
JWT_SECRET_KEY=change-me-to-a-long-random-string-in-local-env
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (프론트엔드 개발 서버)
CORS_ORIGINS=http://localhost:3000

# 로컬 개발(http)에서는 false, 운영(Nginx TLS 종단 뒤)에서는 반드시 true
COOKIE_SECURE=false

# Celery 브로커/백엔드 + WS push용 Redis (docker-compose.yml --requirepass와 일치해야 함)
# unit-7 재작업(DEF-011): 로컬 개발 전용 placeholder 비밀번호. 실제 배포 시 반드시 교체.
REDIS_URL=redis://:final_redis_pw@localhost:6389/0
