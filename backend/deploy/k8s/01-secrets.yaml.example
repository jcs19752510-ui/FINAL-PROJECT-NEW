# unit-30 — 이 파일은 예시(.example)이며 실제 값이 없다. 실제 배포 시
# `01-secrets.yaml`(gitignore 대상)로 복사해 진짜 값을 채우거나, 더 나은 방법으로
# 외부 시크릿 매니저(AWS Secrets Manager/GCP Secret Manager/Vault)를 K8s
# External Secrets Operator로 연동한다 — 이 평문 Secret 매니페스트 방식은
# "최소 실행 가능" 수준일 뿐 원 계획서 §3.2.2(AES-256 저장)가 요구하는 수준의
# 키 관리는 아니다(unit-25가 만든 `FIELD_ENCRYPTION_KEY` 로컬 개발 placeholder와
# 동일한 한계 — unit-30-note.md §3 참고).
apiVersion: v1
kind: Secret
metadata:
  name: backend-secrets
  namespace: mock-interview
type: Opaque
stringData:
  DATABASE_URL: "postgresql+psycopg://REPLACE_ME:REPLACE_ME@REPLACE_ME:5432/mock_interview"
  JWT_SECRET_KEY: "REPLACE_ME_WITH_A_LONG_RANDOM_STRING"
  REDIS_URL: "redis://:REPLACE_ME@redis:6379/0"
  FIELD_ENCRYPTION_KEY: "REPLACE_ME_BASE64_32_BYTES"
